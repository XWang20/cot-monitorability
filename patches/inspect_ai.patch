diff --git a/src/inspect_ai/util/_sandbox/docker/project_registry.py b/src/inspect_ai/util/_sandbox/docker/project_registry.py
new file mode 100644
index 0000000000000000000000000000000000000000..75aacfda4dfab9212b60ca46616258a3c6b67add
--- /dev/null
+++ b/src/inspect_ai/util/_sandbox/docker/project_registry.py
@@ -0,0 +1,129 @@
+import json
+import os
+import tempfile
+from contextlib import contextmanager
+from dataclasses import asdict, dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Iterator
+
+from inspect_ai._util.appdirs import inspect_data_dir
+
+from .util import ComposeProject
+
+PROJECT_REGISTRY_NAME = "docker_projects"
+
+
+@dataclass
+class DockerProjectRecord:
+    project_name: str
+    pid: int
+    task_name: str | None = None
+    model_name: str | None = None
+    sample_id: int | str | None = None
+    epoch: int | None = None
+    config: str | None = None
+    recorded_at: str = field(
+        default_factory=lambda: datetime.now(timezone.utc).isoformat()
+    )
+
+
+def project_registry_path() -> Path:
+    return inspect_data_dir("docker") / f"{PROJECT_REGISTRY_NAME}.json"
+
+
+def project_registry_lock_path() -> Path:
+    return project_registry_path().with_suffix(".lock")
+
+
+@contextmanager
+def locked_project_registry() -> Iterator[None]:
+    import fcntl
+
+    lock_path = project_registry_lock_path()
+    lock_path.parent.mkdir(parents=True, exist_ok=True)
+    with open(lock_path, "a+", encoding="utf-8") as lock_file:
+        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+
+
+def read_project_registry() -> dict[str, DockerProjectRecord]:
+    registry_path = project_registry_path()
+    if not registry_path.exists():
+        return {}
+
+    raw = registry_path.read_text(encoding="utf-8").strip()
+    if not raw:
+        return {}
+
+    payload = json.loads(raw)
+    if not isinstance(payload, dict):
+        raise ValueError(f"Invalid docker project registry format: {registry_path}")
+
+    return {
+        project_name: DockerProjectRecord(**record)
+        for project_name, record in payload.items()
+    }
+
+
+def write_project_registry(records: dict[str, DockerProjectRecord]) -> None:
+    registry_path = project_registry_path()
+    registry_path.parent.mkdir(parents=True, exist_ok=True)
+
+    payload = {
+        project_name: asdict(record)
+        for project_name, record in sorted(records.items())
+    }
+
+    with tempfile.NamedTemporaryFile(
+        mode="w",
+        encoding="utf-8",
+        dir=registry_path.parent,
+        prefix=f"{registry_path.stem}.",
+        suffix=".tmp",
+        delete=False,
+    ) as temp_file:
+        json.dump(payload, temp_file, indent=2, sort_keys=True)
+        temp_file.write("\n")
+        temp_path = Path(temp_file.name)
+
+    os.replace(temp_path, registry_path)
+
+
+def record_project_runtime(
+    project: ComposeProject,
+    *,
+    task_name: str | None,
+    model_name: str | None,
+) -> None:
+    record = DockerProjectRecord(
+        project_name=project.name,
+        pid=os.getpid(),
+        task_name=task_name,
+        model_name=model_name,
+        sample_id=project.sample_id,
+        epoch=project.epoch,
+        config=project.config,
+    )
+    with locked_project_registry():
+        records = read_project_registry()
+        records[project.name] = record
+        write_project_registry(records)
+
+
+def read_project_runtime(project_name: str) -> DockerProjectRecord | None:
+    with locked_project_registry():
+        return read_project_registry().get(project_name)
+
+
+def delete_project_runtime(project_name: str) -> bool:
+    with locked_project_registry():
+        records = read_project_registry()
+        if project_name not in records:
+            return False
+        del records[project_name]
+        write_project_registry(records)
+        return True
