+import sys
+from pathlib import Path
+from types import ModuleType
+from typing import Any
+
+import inspect_ai.dataset._sources.hf as hf_module
+
+
+class FakeDatasetsState:
+    def __init__(self) -> None:
+        self.load_dataset_calls: list[dict[str, Any]] = []
+        self.load_from_disk_calls: list[str] = []
+        self.saved_paths: list[str] = []
+        self.rows_by_path: dict[str, list[dict[str, str]]] = {}
+
+    def load_dataset(self, **kwargs: Any) -> "FakeHFDataset":
+        self.load_dataset_calls.append(kwargs)
+        revision = kwargs.get("revision") or "no-revision"
+        return FakeHFDataset(
+            state=self,
+            rows=[{"input": revision, "target": "target"}],
+        )
+
+    def load_from_disk(self, path: str) -> "FakeHFDataset":
+        self.load_from_disk_calls.append(path)
+        return FakeHFDataset(state=self, rows=self.rows_by_path[path])
+
+
+class FakeHFDataset:
+    def __init__(
+        self, state: FakeDatasetsState, rows: list[dict[str, str]]
+    ) -> None:
+        self.state = state
+        self.rows = rows
+
+    def save_to_disk(self, path: str) -> None:
+        Path(path).mkdir(parents=True, exist_ok=True)
+        self.state.saved_paths.append(path)
+        self.state.rows_by_path[path] = list(self.rows)
+
+    def to_list(self) -> list[dict[str, str]]:
+        return list(self.rows)
+
+
+def install_fake_datasets(
+    monkeypatch: Any, tmp_path: Path
+) -> FakeDatasetsState:
+    state = FakeDatasetsState()
+    datasets_module = ModuleType("datasets")
+    datasets_module.load_dataset = state.load_dataset
+    datasets_module.load_from_disk = state.load_from_disk
+
+    monkeypatch.setitem(sys.modules, "datasets", datasets_module)
+    monkeypatch.setattr(hf_module, "inspect_cache_dir", lambda name: str(tmp_path / name))
+    monkeypatch.setattr(hf_module, "verify_required_version", lambda *args: None)
+
+    return state
+
+
+def test_hf_dataset_reuses_cached_revision(monkeypatch: Any, tmp_path: Path) -> None:
+    state = install_fake_datasets(monkeypatch, tmp_path)
+
+    dataset = hf_module.hf_dataset("org/dataset", split="train", revision="rev-1")
+    assert dataset[0].input == "rev-1"
+    assert len(state.load_dataset_calls) == 1
+    assert state.load_from_disk_calls == []
+
+    cached_dataset = hf_module.hf_dataset(
+        "org/dataset", split="train", revision="rev-1"
+    )
+    assert cached_dataset[0].input == "rev-1"
+    assert len(state.load_dataset_calls) == 1
+    assert state.load_from_disk_calls == [state.saved_paths[0]]
+
+
+def test_hf_dataset_separates_cache_by_revision(
+    monkeypatch: Any, tmp_path: Path
+) -> None:
+    state = install_fake_datasets(monkeypatch, tmp_path)
+
+    hf_module.hf_dataset("org/dataset", split="train", revision="rev-1")
+    hf_module.hf_dataset("org/dataset", split="train", revision="rev-2")
+
+    assert len(state.load_dataset_calls) == 2
+    assert state.load_dataset_calls[0]["revision"] == "rev-1"
+    assert state.load_dataset_calls[1]["revision"] == "rev-2"
+    assert state.saved_paths[0] != state.saved_paths[1]
+
+
+def test_hf_dataset_cached_false_bypasses_revision_cache(
+    monkeypatch: Any, tmp_path: Path
+) -> None:
+    state = install_fake_datasets(monkeypatch, tmp_path)
+
+    hf_module.hf_dataset("org/dataset", split="train", revision="rev-1")
+    hf_module.hf_dataset(
+        "org/dataset", split="train", revision="rev-1", cached=False
+    )
+
+    assert len(state.load_dataset_calls) == 2
+    assert state.load_from_disk_calls == []
