+import clsx from "clsx";
+import { FC, Fragment, ReactNode, useMemo, useState } from "react";
+import { ModelEvent } from "../../../@types/log";
+import { NoContentsPanel } from "../../../components/NoContentsPanel";
+import { ExpandablePanel } from "../../../components/ExpandablePanel";
+import { formatNumber, formatTime } from "../../../utils/format";
+import { APICodeCell } from "../transcript/ModelEventView";
+import styles from "./RequestsView.module.css";
+
+interface RequestsViewProps {
+    events: Array<{ event?: string } | ModelEvent>;
+    failedOnly?: boolean;
+}
+
+interface RequestRow {
+    id: string;
+    model: string;
+    inputTokens: number | null;
+    outputTokens: number | null;
+    duration: number | null;
+    status: "success" | "failed" | "pending";
+    request: string | null;
+    response: string | null;
+    error: string | null;
+}
+
+export const RequestsView: FC<RequestsViewProps> = ({
+    events,
+    failedOnly = false,
+}) => {
+    const requestRows = useMemo(() => {
+        const rows = events.flatMap((event, index) => {
+            if (event.event !== "model") {
+                return [];
+            }
+            return [toRequestRow(event as ModelEvent, index)];
+        });
+
+        return failedOnly
+            ? rows.filter((row) => row.status === "failed")
+            : rows;
+    }, [events, failedOnly]);
+
+    const [expandedRowId, setExpandedRowId] = useState<string | null>(null);
+
+    if (requestRows.length === 0) {
+        return (
+            <NoContentsPanel
+                text={failedOnly ? "No failed requests" : "No requests available"}
+            />
+        );
+    }
+
+    return (
+        <div className={clsx(styles.container)}>
+            <div className={clsx(styles.summary, "text-size-small", "text-style-secondary")}>
+                Showing {formatNumber(requestRows.length)} request
+                {requestRows.length === 1 ? "" : "s"}
+            </div>
+
+            <table className={clsx("table", "table-sm", styles.table)}>
+                <thead>
+                    <tr>
+                        <th>Model</th>
+                        <th>Input</th>
+                        <th>Output</th>
+                        <th>Time</th>
+                        <th>Status</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    {requestRows.map((row) => {
+                        const expanded = expandedRowId === row.id;
+                        return (
+                            <Fragment key={row.id}>
+                                <tr
+                                    className={clsx(styles.dataRow, expanded && styles.expanded)}
+                                    tabIndex={0}
+                                    aria-expanded={expanded}
+                                    onClick={() => {
+                                        setExpandedRowId(expanded ? null : row.id);
+                                    }}
+                                    onKeyDown={(e) => {
+                                        if (e.key === "Enter" || e.key === " ") {
+                                            e.preventDefault();
+                                            setExpandedRowId(expanded ? null : row.id);
+                                        }
+                                    }}
+                                >
+                                    <td>
+                                        <div className={clsx(styles.modelCell)}>
+                                            <div className={clsx(styles.modelName)}>{row.model}</div>
+                                            <div
+                                                className={clsx(
+                                                    styles.hint,
+                                                    "text-size-smallest",
+                                                    "text-style-secondary",
+                                                )}
+                                            >
+                                                Click to {expanded ? "collapse" : "expand"}
+                                            </div>
+                                        </div>
+                                    </td>
+                                    <td>{formatMaybeNumber(row.inputTokens)}</td>
+                                    <td>{formatMaybeNumber(row.outputTokens)}</td>
+                                    <td>{row.duration !== null ? formatTime(row.duration) : "-"}</td>
+                                    <td>
+                                        <StatusBadge status={row.status} />
+                                    </td>
+                                </tr>
+                                {expanded ? (
+                                    <tr className={clsx(styles.detailsRow)}>
+                                        <td colSpan={5}>
+                                            <div className={clsx(styles.detailsGrid)}>
+                                                <RequestDetailSection title="Request JSON">
+                                                    {row.request ? (
+                                                        <ExpandablePanel
+                                                            id={`${row.id}-request`}
+                                                            collapse={true}
+                                                            lines={18}
+                                                            border={true}
+                                                            togglePosition="block-left"
+                                                        >
+                                                            <APICodeCell id={`${row.id}-request-code`} sourceCode={row.request} />
+                                                        </ExpandablePanel>
+                                                    ) : (
+                                                        <EmptyState text="Request JSON not available" />
+                                                    )}
+                                                </RequestDetailSection>
+
+                                                <RequestDetailSection title="Response JSON">
+                                                    {row.response ? (
+                                                        <ExpandablePanel
+                                                            id={`${row.id}-response`}
+                                                            collapse={true}
+                                                            lines={18}
+                                                            border={true}
+                                                            togglePosition="block-left"
+                                                        >
+                                                            <APICodeCell
+                                                                id={`${row.id}-response-code`}
+                                                                sourceCode={row.response}
+                                                            />
+                                                        </ExpandablePanel>
+                                                    ) : (
+                                                        <EmptyState text="Response JSON not available" />
+                                                    )}
+                                                </RequestDetailSection>
+
+                                                <RequestDetailSection title="Error Text">
+                                                    {row.error ? (
+                                                        <ExpandablePanel
+                                                            id={`${row.id}-error`}
+                                                            collapse={true}
+                                                            lines={10}
+                                                            border={true}
+                                                            togglePosition="block-left"
+                                                        >
+                                                            <pre className={clsx(styles.errorText, "text-size-small")}>{row.error}</pre>
+                                                        </ExpandablePanel>
+                                                    ) : (
+                                                        <EmptyState text="No error" />
+                                                    )}
+                                                </RequestDetailSection>
+                                            </div>
+                                        </td>
+                                    </tr>
+                                ) : null}
+                            </Fragment>
+                        );
+                    })}
+                </tbody>
+            </table>
+        </div>
+    );
+};
+
+const toRequestRow = (event: ModelEvent, index: number): RequestRow => {
+    const error = event.error || event.output.error;
+    const callData = extractModelCallData(event);
+    return {
+        id: event.uuid || `${event.span_id || event.timestamp || "request"}-${index}`,
+        model: event.model,
+        inputTokens: event.output.usage?.input_tokens ?? null,
+        outputTokens: event.output.usage?.output_tokens ?? null,
+        duration:
+            callData.time ?? event.call?.time ?? event.output.time ?? event.working_time ?? null,
+        status: resolveStatus(event, error),
+        request: toJsonString(callData.request),
+        response: toJsonString(callData.response),
+        error,
+    };
+};
+
+interface ModelCallData {
+    request: unknown | null;
+    response: unknown | null;
+    time: number | null;
+}
+
+const extractModelCallData = (event: ModelEvent): ModelCallData => {
+    const fallbackRequest = buildFallbackRequest(event);
+    const call = (event as unknown as { call?: unknown }).call;
+    if (!call || typeof call !== "object" || Array.isArray(call)) {
+        return {
+            request: fallbackRequest,
+            response: null,
+            time: null,
+        };
+    }
+
+    const record = call as Record<string, unknown>;
+    return {
+        request: record.request ?? fallbackRequest,
+        response: record.response ?? null,
+        time: typeof record.time === "number" ? record.time : null,
+    };
+};
+
+const buildFallbackRequest = (event: ModelEvent): Record<string, unknown> => {
+    const request: Record<string, unknown> = {
+        model: event.model,
+        messages: normalizeMessages(event.input),
+    };
+
+    if (event.tools && event.tools.length > 0) {
+        request.tools = event.tools.map((tool) => ({
+            type: "function",
+            function: {
+                name: tool.name,
+                description: tool.description,
+                parameters: tool.parameters,
+            },
+        }));
+    }
+
+    const toolChoice = normalizeToolChoice(event.tool_choice);
+    if (toolChoice !== undefined) {
+        request.tool_choice = toolChoice;
+    }
+
+    Object.assign(request, normalizeConfig(event.config));
+    return request;
+};
+
+const normalizeMessages = (messages: ModelEvent["input"]): unknown[] => {
+    return messages.map((message) => {
+        const normalized: Record<string, unknown> = {
+            role: message.role,
+            content: normalizeContent(message.content),
+        };
+
+        if (message.role === "assistant" && "tool_calls" in message && message.tool_calls) {
+            normalized.tool_calls = message.tool_calls.map((toolCall) => ({
+                id: toolCall.id,
+                type: toolCall.type,
+                function: {
+                    name: toolCall.function,
+                    arguments: JSON.stringify(toolCall.arguments ?? {}),
+                },
+            }));
+        }
+
+        if (message.role === "tool") {
+            if ("tool_call_id" in message && message.tool_call_id) {
+                normalized.tool_call_id = message.tool_call_id;
+            }
+            if ("function" in message && message.function) {
+                normalized.name = message.function;
+            }
+        }
+
+        return normalized;
+    });
+};
+
+const normalizeContent = (content: unknown): unknown => {
+    if (typeof content === "string") {
+        return content;
+    }
+    if (!Array.isArray(content)) {
+        return content;
+    }
+
+    return content.map((item) => {
+        if (!item || typeof item !== "object") {
+            return item;
+        }
+
+        const record = item as Record<string, unknown>;
+        switch (record.type) {
+            case "text":
+                return { type: "text", text: record.text ?? "" };
+            case "image":
+                return {
+                    type: "image_url",
+                    image_url: {
+                        url: record.image,
+                        detail: record.detail,
+                    },
+                };
+            case "audio":
+                return {
+                    type: "input_audio",
+                    input_audio: {
+                        data: record.audio,
+                        format: record.format,
+                    },
+                };
+            case "reasoning":
+                return { type: "text", text: record.reasoning ?? "" };
+            default:
+                return record;
+        }
+    });
+};
+
+const normalizeToolChoice = (toolChoice: ModelEvent["tool_choice"]): unknown => {
+    if (toolChoice === null || toolChoice === undefined) {
+        return undefined;
+    }
+    if (toolChoice === "any") {
+        return "required";
+    }
+    if (typeof toolChoice === "string") {
+        return toolChoice;
+    }
+
+    const toolFunction = toolChoice as unknown as Record<string, unknown>;
+    if (typeof toolFunction.name === "string") {
+        return {
+            type: "function",
+            function: { name: toolFunction.name },
+        };
+    }
+
+    return toolChoice;
+};
+
+const normalizeConfig = (config: ModelEvent["config"]): Record<string, unknown> => {
+    const normalized: Record<string, unknown> = {};
+    const maybeSet = (key: string, value: unknown) => {
+        if (value !== null && value !== undefined) {
+            normalized[key] = value;
+        }
+    };
+
+    maybeSet("max_tokens", config.max_tokens);
+    maybeSet("top_p", config.top_p);
+    maybeSet("temperature", config.temperature);
+    maybeSet("stop", config.stop_seqs);
+    maybeSet("best_of", config.best_of);
+    maybeSet("frequency_penalty", config.frequency_penalty);
+    maybeSet("presence_penalty", config.presence_penalty);
+    maybeSet("logit_bias", config.logit_bias);
+    maybeSet("seed", config.seed);
+    maybeSet("top_k", config.top_k);
+    maybeSet("n", config.num_choices);
+    maybeSet("logprobs", config.logprobs);
+    maybeSet("top_logprobs", config.top_logprobs);
+    maybeSet("parallel_tool_calls", config.parallel_tool_calls);
+    maybeSet("reasoning_effort", config.reasoning_effort);
+
+    if (config.response_schema) {
+        normalized.response_format = {
+            type: "json_schema",
+            json_schema: {
+                name: config.response_schema.name,
+                schema: config.response_schema.json_schema,
+                strict: config.response_schema.strict,
+                description: config.response_schema.description,
+            },
+        };
+    }
+
+    if (config.extra_body && typeof config.extra_body === "object") {
+        Object.assign(normalized, config.extra_body);
+    }
+
+    return normalized;
+};
+
+const resolveStatus = (
+    event: ModelEvent,
+    error: string | null,
+): RequestRow["status"] => {
+    if (event.pending) {
+        return "pending";
+    }
+    if (error) {
+        return "failed";
+    }
+    return "success";
+};
+
+const toJsonString = (value: unknown): string | null => {
+    if (value === null || value === undefined) {
+        return null;
+    }
+    return JSON.stringify(value, undefined, 2);
+};
+
+const formatMaybeNumber = (value: number | null): string => {
+    return value !== null ? formatNumber(value) : "-";
+};
+
+const StatusBadge: FC<{ status: RequestRow["status"] }> = ({ status }) => {
+    const label =
+        status === "success"
+            ? "Success"
+            : status === "failed"
+                ? "Failed"
+                : "Pending";
+
+    return (
+        <span
+            className={clsx(
+                styles.status,
+                status === "success" && styles.success,
+                status === "failed" && styles.failed,
+                status === "pending" && styles.pending,
+            )}
+        >
+            {label}
+        </span>
+    );
+};
+
+const RequestDetailSection: FC<{ title: string; children: ReactNode }> = ({
+    title,
+    children,
+}) => {
+    return (
+        <section className={clsx(styles.detailSection)}>
+            <div className={clsx(styles.detailTitle, "text-style-label")}>{title}</div>
+            {children}
+        </section>
+    );
+};
+
+const EmptyState: FC<{ text: string }> = ({ text }) => {
+    return (
+        <div className={clsx(styles.emptyState, "text-size-small", "text-style-secondary")}>
+            {text}
+        </div>
+    );
+};
