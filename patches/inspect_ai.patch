+        counter_file.write_text(str(attempt + 1))
+
+        output = ModelOutput.from_content("mockllm/model", f"attempt {attempt + 1}")
+        output.usage = ModelUsage(input_tokens=10, output_tokens=5, total_tokens=15)
+        result = await get_model("mockllm/model", custom_outputs=[output]).generate(
+            state.messages
+        )
+        state.messages.append(result.message)
