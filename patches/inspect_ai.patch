+import json
+from pathlib import Path
+
+from inspect_ai.util._sandbox.docker.cleanup import (
+    project_cleanup,
+    project_cleanup_startup,
+    project_startup,
+)
+from inspect_ai.util._sandbox.docker.project_registry import (
+    delete_project_runtime,
+    project_registry_path,
+    read_project_runtime,
+    record_project_runtime,
+)
+from inspect_ai.util._sandbox.docker.util import ComposeProject
+
+
+def test_project_runtime_roundtrip(tmp_path: Path, monkeypatch) -> None:
+    registry_path = tmp_path / "docker_projects.json"
+    monkeypatch.setattr(
+        "inspect_ai.util._sandbox.docker.project_registry.project_registry_path",
+        lambda: registry_path,
+    )
+
+    project = ComposeProject(
+        name="inspect-demo-iabc123",
+        config="/tmp/demo.compose.yaml",
+        sample_id="sample-7",
+        epoch=2,
+        env={},
+    )
+
+    record_project_runtime(project, task_name="demo_task", model_name="openai/gpt")
+    record = read_project_runtime(project.name)
+
+    assert record is not None
+    assert record.project_name == project.name
+    assert record.pid > 0
+    assert record.task_name == "demo_task"
+    assert record.model_name == "openai/gpt"
+    assert record.sample_id == "sample-7"
+    assert record.epoch == 2
+    assert record.config == "/tmp/demo.compose.yaml"
+
+    raw = json.loads(registry_path.read_text(encoding="utf-8"))
+    assert raw[project.name]["pid"] == record.pid
+    assert raw[project.name]["task_name"] == "demo_task"
+
+
+def test_project_runtime_delete(tmp_path: Path, monkeypatch) -> None:
+    registry_path = tmp_path / "docker_projects.json"
+    monkeypatch.setattr(
+        "inspect_ai.util._sandbox.docker.project_registry.project_registry_path",
+        lambda: registry_path,
+    )
+
+    project = ComposeProject(
+        name="inspect-demo-idef456",
+        config=None,
+        sample_id=None,
+        epoch=None,
+        env={},
+    )
+
+    record_project_runtime(project, task_name="demo_task", model_name=None)
+    assert delete_project_runtime(project.name) is True
+    assert read_project_runtime(project.name) is None
+
+
+async def test_project_cleanup_clears_registry_when_project_stops(
+    tmp_path: Path, monkeypatch
+) -> None:
+    registry_path = tmp_path / "docker_projects.json"
+    monkeypatch.setattr(
+        "inspect_ai.util._sandbox.docker.project_registry.project_registry_path",
+        lambda: registry_path,
+    )
+
+    project = ComposeProject(
+        name="inspect-demo-ighi789",
+        config=None,
+        sample_id=None,
+        epoch=None,
+        env={},
+    )
+
+    async def fake_compose_down(project: ComposeProject, quiet: bool = True) -> None:
+        return None
+
+    async def fake_compose_ps(
+        project: ComposeProject, all: bool = False
+    ) -> list[dict[str, str]]:
+        return []
+
+    monkeypatch.setattr(
+        "inspect_ai.util._sandbox.docker.cleanup.compose_down", fake_compose_down
+    )
+    monkeypatch.setattr(
+        "inspect_ai.util._sandbox.docker.cleanup.compose_ps", fake_compose_ps
+    )
+
+    record_project_runtime(project, task_name="demo_task", model_name=None)
+    project_cleanup_startup()
+    project_startup(project)
+
+    await project_cleanup(project)
+
+    assert read_project_runtime(project.name) is None
+
+
+def test_project_registry_path_uses_json_suffix() -> None:
+    assert project_registry_path().suffix == ".json"
